// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String      @id @default(uuid()) @db.Uuid
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  email       String      @unique
  phoneNumber String      @unique
  status      String      @default("1") @db.VarChar(1)  // 1 - verified 2- unverified 3-blocked
  hash        String
  hashedRt    String?
  firstName   String?
  lastName    String?
  gender      Boolean?
  token       String?
  images      UserImage[]

  roles             Role[]
  appointments      Appointment[]
  favoriteCompanies Company[]
  comments          CommentModel[]
  notifications     NotificationModel[]

  employee Employee?
  Address  Address?

}

model Role {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  users User[]
}

model Category {
  id     String          @id @default(uuid()) @db.Uuid
  name   String          @unique @db.VarChar(40)
  images CategoryImage[]

  companies Company[]
  services  Service[]
}

model Company {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  name        String   @db.VarChar(40)
  phoneNumber String   @unique @db.VarChar(15)

  // Relations
  companySettings CompanySettings?

  images         CompanyImage[]
  employees      Employee[]
  category       Category[]
  favoritedUsers User[]
  comments       CommentModel[]
}

model Employee {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  description String   @db.VarChar(150)

  // Relations
  employeeSettings EmployeeSettings?

  images         EmployeeImage[]
  serviceDetails ServiceDetails[]

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  userId String? @unique @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Service {
  id   String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(50)

  // Relations
  category Category[]
  details  ServiceDetails[]
  images   ServiceImage[]
}

model ServiceDetails {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  description String   @db.VarChar(150)
  cost        Decimal
  duration    Int      @db.SmallInt
  isRecurred  Boolean  @default(false)
  canBeGroup  Boolean  @default(false)

  // Relations
  serviceId String  @db.Uuid
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  employeeId        String              @db.Uuid
  employee          Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  AppointmentDetail AppointmentDetail[]

  @@unique([serviceId, employeeId])
}

model Address {
  id     String @id @default(uuid()) @db.Uuid
  city   String
  region String

  locationId String    @db.Uuid
  Location   Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id])
}

model WorkingCompanyDays {
  id        String  @id @default(uuid()) @db.Uuid
  day       String  @db.VarChar(1)
  status    Boolean
  startTime String  @db.VarChar(5)
  endTime   String  @db.VarChar(5)

  companySettings   CompanySettings @relation(fields: [companySettingsId], references: [id])
  companySettingsId String          @db.Uuid
}

model WorkingEmployeeDays {
  id        String  @id @default(uuid()) @db.Uuid
  day       String  @db.VarChar(1)
  status    Boolean
  startTime String?  @db.VarChar(5)
  endTime   String?  @db.VarChar(5)

  employeeSettings   EmployeeSettings @relation(fields: [employeeSettingsId], references: [id], onDelete: Cascade)
  employeeSettingsId String           @db.Uuid
}

model Appointment {
  id            String   @id @default(uuid()) @db.Uuid
  creatorUserId String?   @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  totalPrice    Decimal
  totalDuration Int      @db.SmallInt

  users             User[]
  appointmentDetail AppointmentDetail[]
  notifications     NotificationModel[]
  comments          CommentModel[]
}

model AppointmentDetail {
  id                  String   @id @default(uuid()) @db.Uuid
  creatorUserId       String?   @db.Uuid
  appointmentStatus   String   @default("0") @db.VarChar(1)
  appointmentDateTime DateTime
  hasPaymentMade      Boolean  @default(false)

  appointmentId String      @db.Uuid
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  serviceDetails ServiceDetails[]
}

// Settings models
model CompanySettings {
  id String @id @default(uuid()) @db.Uuid

  companyId String  @unique @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  companyAddress   CompanyAddress? @relation(fields: [companyAddressId], references: [id])
  companyAddressId String?         @unique @db.Uuid

  workingDays WorkingCompanyDays[]
}

model EmployeeSettings {
  id String @id @default(uuid()) @db.Uuid

  employeeId String   @unique @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id],  onDelete: Cascade)

  workingDays WorkingEmployeeDays[]
}

// Image models
model UserImage {
  id        String   @id @default(uuid()) @db.Uuid
  imageUrl  String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CompanyImage {
  id        String   @id @default(uuid()) @db.Uuid
  imageUrl  String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model CategoryImage {
  id        String   @id @default(uuid()) @db.Uuid
  imageUrl  String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model EmployeeImage {
  id        String   @id @default(uuid()) @db.Uuid
  imageUrl  String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  employeeId String   @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model ServiceImage {
  id        String   @id @default(uuid()) @db.Uuid
  imageUrl  String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  // Relations
  serviceId String  @db.Uuid
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model CompanyAddress {
  id         String    @id @default(uuid()) @db.Uuid
  address    String    @db.VarChar(150)
  countryId  String    @db.Uuid
  country    Country   @relation(fields: [countryId], references: [id], onDelete: Cascade)
  cityId     String    @db.Uuid
  city       City      @relation(fields: [cityId], references: [id], onDelete: Cascade)
  districtId String    @db.Uuid
  district   District  @relation(fields: [districtId], references: [id], onDelete: Cascade)
  locationId String    @db.Uuid
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  companySettings CompanySettings?
}

model Country {
  id        String           @id @default(uuid()) @db.Uuid
  name      String           @unique @db.VarChar(10)
  cities    City[]
  addresses CompanyAddress[]
}

model City {
  id        String           @id @default(uuid()) @db.Uuid
  countryId String           @db.Uuid
  country   Country          @relation(fields: [countryId], references: [id], onDelete: Cascade)
  name      String           @unique @db.VarChar(20)
  districts District[]
  adresses  CompanyAddress[]
}

model District {
  id       String           @id @default(uuid()) @db.Uuid
  name     String           @db.VarChar(50)
  cityId   String           @db.Uuid
  City     City             @relation(fields: [cityId], references: [id], onDelete: Cascade)
  adresses CompanyAddress[]
}

model Location {
  id       String           @id @default(uuid()) @db.Uuid
  lat      Float
  lng      Float
  adresses CompanyAddress[]
  Address  Address[]
}

model NotificationModel {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  title     String   @db.VarChar(150)
  message   String   @db.VarChar(150)
  isReaded  Boolean  @default(false)

  userId    String    @db.Uuid
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  appointmentId    String?    @db.Uuid
  appointment      Appointment?     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model CommentModel {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  comment   String?   @db.VarChar(150)
  star      String   @db.VarChar(1)

  appoinmentId String    @db.Uuid
  appoinment   Appointment? @relation(fields: [appoinmentId], references: [id], onDelete: Cascade)

  companyId String?    @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  userId    String    @db.Uuid
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  images    CommentImage[] 
}

model CommentImage {
  id        String   @id @default(uuid()) @db.Uuid
  imageUrl  String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  commentId String  @db.Uuid
  comment   CommentModel @relation(fields: [commentId], references: [id], onDelete: Cascade)
}
